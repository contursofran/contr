{
  "description": "Workers: a turn that ends without hc send still reports to the coordinator. Coordinators: save the state before a compaction and get the playbook back after it.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CONTR_COORDINATOR$HC_TERMINAL_ID\" ] || contr hook stop || exit 1",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$HC_TERMINAL_ID\" ] || contr hook session-start || exit 1",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
